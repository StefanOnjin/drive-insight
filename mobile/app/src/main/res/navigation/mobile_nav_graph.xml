    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_nav_graph"
    app:startDestination="@id/recordFragment">

    <fragment
        android:id="@+id/historyFragment"
        android:name="com.driveinsight.mobile.ui.history.HistoryFragment"
        android:label="@string/nav_history"
        tools:layout="@layout/fragment_history" />

    <fragment
        android:id="@+id/recordFragment"
        android:name="com.driveinsight.mobile.ui.record.RecordFragment"
        android:label="@string/nav_record"
        tools:layout="@layout/fragment_record" />

    <fragment
        android:id="@+id/chatFragment"
        android:name="com.driveinsight.mobile.ui.chat.ChatFragment"
        android:label="@string/nav_chat"
